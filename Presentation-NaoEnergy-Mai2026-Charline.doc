<style>
@page { size: A4 landscape; margin: 1.5cm 2cm; }
body { font-family: 'Calibri', 'Segoe UI', sans-serif; font-size: 12pt; color: #233036; line-height: 1.5; }

/* Slide-like sections (page break between slides) */
.slide { page-break-after: always; min-height: 18cm; padding: 20px 0; }
.slide-cover { text-align: center; padding-top: 4cm; }
.slide-title { font-size: 36pt; color: #7CB1C4; font-weight: 800; margin: 0 0 20px 0; }
.slide-subtitle { font-size: 18pt; color: #69625C; margin: 0 0 30px 0; }
.slide-meta { font-size: 11pt; color: #69625C; margin-top: 60px; }

/* Act badges */
.act-badge { display: inline-block; background: #7CB1C4; color: #fff; padding: 8px 18px; border-radius: 20px; font-size: 14pt; font-weight: 700; letter-spacing: 1px; margin-bottom: 16px; }
.act-1 { background: #E85D4A; }
.act-2 { background: #6F3EAA; }
.act-3 { background: #2A8F4D; }

h1 { font-size: 28pt; color: #233036; margin: 6px 0 24px 0; border-bottom: 4px solid #7CB1C4; padding-bottom: 8px; }
h2 { font-size: 18pt; color: #5A98AE; margin-top: 20px; }
h3 { font-size: 14pt; color: #233036; margin-top: 14px; }

.hero-quote { font-size: 16pt; color: #233036; font-style: italic; padding: 18px 24px; background: #f9fafc; border-left: 5px solid #7CB1C4; margin: 18px 0; border-radius: 0 8px 8px 0; }

/* Issue cards (Act 1) */
.issue-grid { width: 100%; border-collapse: separate; border-spacing: 12px; margin-top: 12px; }
.issue-card { background: #FFF5F2; border-left: 5px solid #E85D4A; padding: 14px 18px; border-radius: 0 8px 8px 0; }
.issue-card .issue-title { font-weight: 700; color: #C44A1F; font-size: 12pt; margin-bottom: 6px; }
.issue-card .issue-detail { font-size: 10.5pt; color: #233036; }

/* Win cards (Act 2) */
.win-card { background: #F0FAF4; border-left: 5px solid #2A8F4D; padding: 14px 18px; border-radius: 0 8px 8px 0; margin: 10px 0; }
.win-card .win-title { font-weight: 700; color: #1B5E20; font-size: 12pt; margin-bottom: 6px; }
.win-card .win-detail { font-size: 10.5pt; color: #233036; }
.win-card ul { margin: 6px 0 0 0; padding-left: 20px; }
.win-card li { font-size: 10.5pt; margin: 2px 0; }

/* Proof cards (Act 3) */
.proof-card { background: #f9fafc; border-left: 5px solid #5A98AE; padding: 16px 20px; border-radius: 0 8px 8px 0; margin: 14px 0; }
.proof-card .proof-tool { font-weight: 700; color: #5A98AE; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
.proof-card .proof-prompt { font-size: 11pt; color: #233036; margin-bottom: 8px; }
.proof-card .proof-action { background: #fff; border: 1px dashed #5A98AE; padding: 10px 14px; font-size: 10pt; color: #69625C; font-style: italic; border-radius: 6px; }
.proof-card .proof-result { background: #E8F5E9; padding: 10px 14px; font-size: 10pt; color: #1B5E20; border-radius: 6px; margin-top: 6px; min-height: 30px; }

/* Tables */
table { width: 100%; border-collapse: collapse; margin: 12px 0; }
th { background: #7CB1C4; color: #fff; padding: 10px 12px; text-align: left; font-size: 11pt; }
td { padding: 8px 12px; border-bottom: 1px solid #E1E8F0; font-size: 10.5pt; vertical-align: top; }
tr:nth-child(even) td { background: #f9fafc; }

/* Sprint 2 callout */
.sprint2-card { background: #f9fafc; border: 2px solid #7CB1C4; border-radius: 10px; padding: 18px 22px; margin: 16px 0; }
.sprint2-card h3 { color: #7CB1C4; margin-top: 0; }
.sprint2-card .label { display: inline-block; background: #7CB1C4; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 9pt; font-weight: 700; margin-right: 8px; }

.toc { background: #f9fafc; border: 1px solid #E1E8F0; padding: 18px 24px; border-radius: 8px; }
.toc h3 { margin-top: 0; color: #5A98AE; }
.toc ol { padding-left: 24px; }
.toc li { padding: 6px 0; font-size: 12pt; }

.key-figure { font-size: 36pt; font-weight: 800; color: #2A8F4D; line-height: 1; }
.key-label { font-size: 11pt; color: #69625C; margin-top: 6px; }
.metric-grid { display: table; width: 100%; border-spacing: 14px; margin: 18px 0; }
.metric-cell { display: table-cell; width: 33%; background: #f9fafc; padding: 20px; border-radius: 10px; text-align: center; border-top: 4px solid #2A8F4D; }

p { margin: 8px 0; }
</style>
</head>
